meta {
  name: Create Client
  type: http
  seq: 1
}

post {
  url: {{host}}/v1/database/clients
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
      "customerId": "123",
      "name": "John Doe",
      "alias": "jdoe",
      "phone": "555-1234",
      "email": "jdoe@example.com",
      "address": "123 Main St",
      "description": "A sample client",
      "status": "ACTIVE"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
