meta {
  name: create work order complete
  type: http
  seq: 7
}

post {
  url: {{ispdev}}/v1/work-orders
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer <TOKEN>
}

body:json {
  {
    "ticketNumber": "TKT-001",                    // optional
    "noWorkOrder": "WO-2025-001",                 // optional
    "activityId": "activity-id-here",             // required
    "siteId": "site-id-here",                     // required
    "teamId": "team-id-here",                     // optional
    "slotId": "slot-id-here",                     // optional
    "bookingAt": "2025-05-16T10:00:00Z",          // required (RFC3339)
    "openedAt": "2025-05-15T08:00:00Z",           // required (RFC3339)
    "description": "Instalasi baru pelanggan",    // optional
    "properties": {                               // required
      "fields": [
        {
          "fieldId": "field-id-1",                // required
          "order": 1,                             // optional
          "value": "John Doe",                    // untuk FREE_TEXT, NUMBER, DATE, DROPDOWN
          "values": [],                           // untuk CHECKBOX (array of selected values)
          "fileId": "file-upload-id",             // untuk CAMERA, UPLOAD_IMAGE, CAMERA_OR_UPLOAD_IMAGE
          "fileIds": [],                          // untuk MULTIPLE_CAMERA, MULTIPLE_UPLOAD_IMAGE
          "location": {                           // optional (koordinat)
            "lat": -6.2088,
            "long": 106.8456
          }
        }
      ]
    },
    "interactionItems": [                         // optional
      {
        "id": "item-id",
        "order": 1,
        "value": "some value",
        "values": [],
        "fileId": null,
        "fileIds": [],
        "location": null
      }
    ],
    "metadata": {                                 // optional (key-value pairs)
      "source": "mobile",
      "version": "1.0"
    }
  }
  
}

settings {
  encodeUrl: false
  timeout: 0
}
